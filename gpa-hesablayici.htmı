<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GPA Hesablayıcısı</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FAF8F4; --ink:#1C1B19; --teal:#1F4E4A; --gold:#B8905A;
    --line:#DBD6CC; --panel:#FFFFFF; --muted:#6B665C;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:'Inter',sans-serif;}
  header{padding:28px 32px 20px;border-bottom:1px solid var(--line);}
  header h1{font-family:'Fraunces',serif;font-weight:600;font-size:28px;margin:0 0 4px;}
  header p{margin:0;color:var(--muted);font-size:14px;}
  .wrap{max-width:720px;margin:0 auto;padding:28px 32px;}
  table{width:100%;border-collapse:collapse;background:var(--panel);border:1px solid var(--line);}
  th{font-family:'Fraunces',serif;font-weight:600;font-size:13px;text-align:left;color:var(--teal);padding:10px 10px;border-bottom:1px solid var(--line);}
  td{padding:6px 8px;border-bottom:1px solid var(--line);}
  input{width:100%;padding:8px 9px;border:1px solid var(--line);border-radius:3px;font-family:inherit;font-size:14px;background:#fff;color:var(--ink);}
  input.grade{width:80px;}
  input.credit{width:70px;}
  .remove{background:none;border:none;color:var(--muted);cursor:pointer;font-size:16px;line-height:1;}
  .remove:hover{color:#B33;}
  .toolbar{display:flex;justify-content:space-between;align-items:center;margin-top:14px;flex-wrap:wrap;gap:10px;}
  .add-btn{background:none;border:1px dashed var(--teal);color:var(--teal);padding:8px 14px;border-radius:3px;cursor:pointer;font-size:13.5px;font-family:inherit;}
  .add-btn:hover{background:#EEF3F2;}
  .result{margin-top:22px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--teal);padding:18px 20px;}
  .result .label{font-size:12.5px;color:var(--muted);}
  .result .value{font-family:'Fraunces',serif;font-size:34px;color:var(--teal);}
  .scale-note{font-size:12px;color:var(--muted);margin-top:10px;}
</style>
</head>
<body>
<header>
  <h1>GPA Hesablayıcısı</h1>
  <p>Fənlərinizi, qiymətlərinizi (4.0 şkalası üzrə) və kreditlərini daxil edin — orta balınız avtomatik hesablanır.</p>
</header>

<div class="wrap">
  <table>
    <thead>
      <tr><th>Fənn</th><th>Qiymət (0–4)</th><th>Kredit</th><th></th></tr>
    </thead>
    <tbody id="rows"></tbody>
  </table>

  <div class="toolbar">
    <button class="add-btn" onclick="addRow()">+ Fənn əlavə et</button>
  </div>

  <div class="result">
    <div class="label">Orta bal (GPA)</div>
    <div class="value" id="gpa">0.00</div>
  </div>
  <p class="scale-note">Qiymət 4.0 şkalası üzrədir (A=4, B=3, C=2, D=1, F=0). Başqa şkala istifadə edirsinizsə, qiymətinizi əvvəlcə 4.0-a çevirin.</p>
</div>

<script>
let rows = [
  {name:'', grade:'', credit:''},
  {name:'', grade:'', credit:''},
  {name:'', grade:'', credit:''}
];

function addRow(){ rows.push({name:'',grade:'',credit:''}); render(); }
function removeRow(i){ rows.splice(i,1); render(); calc(); }

function render(){
  document.getElementById('rows').innerHTML = rows.map((r,i)=>`
    <tr>
      <td><input value="${r.name}" placeholder="Fənn adı" oninput="rows[${i}].name=this.value"></td>
      <td><input class="grade" type="number" min="0" max="4" step="0.1" value="${r.grade}" oninput="rows[${i}].grade=this.value;calc()"></td>
      <td><input class="credit" type="number" min="0" step="0.5" value="${r.credit}" oninput="rows[${i}].credit=this.value;calc()"></td>
      <td>${rows.length>1?`<button class="remove" onclick="removeRow(${i})">✕</button>`:''}</td>
    </tr>`).join('');
}

function calc(){
  let totalPoints = 0, totalCredits = 0;
  rows.forEach(r=>{
    const g = parseFloat(r.grade), c = parseFloat(r.credit);
    if(!isNaN(g) && !isNaN(c) && c>0){
      totalPoints += g*c;
      totalCredits += c;
    }
  });
  const gpa = totalCredits>0 ? (totalPoints/totalCredits) : 0;
  document.getElementById('gpa').textContent = gpa.toFixed(2);
}

render();
calc();
</script>
</body>
</html>